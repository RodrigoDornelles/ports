{
  "version": 8,
  "configurePresets": [
    {
      "name": "arm",
      "binaryDir": "${sourceDir}/build_arm",
      "cacheVariables": {
        "TARGET": "arm-linux-gnueabihf"
      }
    },
    {
      "name": "wasm",
      "binaryDir": "${sourceDir}/build_wasm",
      "cacheVariables": {
        "PORTS_WASM": "ON",
        "PORTS_USE_SDL_LIBRETRO": "OFF",
        "PORTS_USE_PRBOOMTV_LIBRETRO": "ON",
        "PORTS_USE_RETROARCH": "ON",
        "DOPO_USE_BALATRO_WEB_PATCH": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm",
      "configurePreset": "arm"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    }
  ]
}
